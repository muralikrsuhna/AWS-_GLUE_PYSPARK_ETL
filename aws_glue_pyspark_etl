
from pyspark.sql.functions import *
from pyspark.sql.types import *
from pyspark.sql import SparkSession

spark = SparkSession.builder.appName("ETLJob").getOrCreate()

# Step 1: Read from S3
df = spark.read.option("header", True).csv("s3://finalapi-glue-job/finalapi.csv")

# Step 2: Transformation
df_cl = df.filter(col("prod_line")=="CL")
df_pl =df.filter(col("prod_line")=="PL")

# Step 3: Write back to S3
df_cl.write.mode("overwrite").parquet("s3://etldestination-file/etl_pipeline-1/prod_line_cl.csv")
df_pl.write.mode("overwrite").parquet("s3://etldestination-file/etl_pipeline-1/prod_line_pl.csv")
spark.stop()
